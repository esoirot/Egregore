{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": "Weekly version bumps for every pin in this repo. Built-in managers cover Dockerfiles, compose files, devcontainer features, package.json, pyproject.toml and GitHub Actions; the regex managers below cover pins Renovate cannot find on its own.",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "devcontainer": {
    "description": "Templates keep their .devcontainer/ below templates/*/scaffold/, not at the repo root",
    "managerFilePatterns": [
      "/(^|/)\\.devcontainer/devcontainer\\.json$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Template pins annotated on the line above: '# renovate: datasource=<ds> depName=<name> [versioning=<v>] [extractVersion=<re>]' ('//' in JSON files). A new template needs no change here.",
      "managerFilePatterns": [
        "/(^|/)templates/.+/"
      ],
      "matchStrings": [
        "(?:#|//)\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n[^\\n]*?(?<currentValue>\\d+(?:\\.\\d+)*)"
      ]
    },
    {
      "customType": "regex",
      "description": "pnpm version option of the node feature (the devcontainer manager already tracks Node itself)",
      "managerFilePatterns": [
        "/(^|/)\\.devcontainer/devcontainer\\.json$/"
      ],
      "matchStrings": [
        "\"pnpmVersion\"\\s*:\\s*\"(?<currentValue>[\\d.]+)\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pnpm"
    },
    {
      "customType": "regex",
      "description": "Gradle version option of the java feature",
      "managerFilePatterns": [
        "/(^|/)\\.devcontainer/devcontainer\\.json$/"
      ],
      "matchStrings": [
        "\"gradleVersion\"\\s*:\\s*\"(?<currentValue>[\\d.]+)\""
      ],
      "datasourceTemplate": "gradle-version",
      "depNameTemplate": "gradle"
    },
    {
      "customType": "regex",
      "description": "npm global installs in Dockerfiles: @devcontainers/cli, pnpm",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "npm install --global (?<depName>@?[\\w./-]+)@(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "devcontainer-cli image tag follows the CLI version",
      "managerFilePatterns": [
        "/(^|/)images/devcontainer-cli/image\\.env$/"
      ],
      "matchStrings": [
        "devcontainer-cli:(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@devcontainers/cli"
    }
  ],
  "packageRules": [
    {
      "description": "One PR per runtime, across all the files that pin it (they must stay equal)",
      "matchPackageNames": [
        "node",
        "pnpm",
        "python",
        "uv",
        "ruby",
        "java",
        "gradle",
        "ruff",
        "@devcontainers/cli"
      ],
      "groupName": "{{packageName}}"
    },
    {
      "description": "Docker images of the same runtime join their runtime group",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node",
        "python",
        "ghcr.io/astral-sh/uv",
        "amazoncorretto"
      ],
      "groupName": "{{#if (equals packageName 'ghcr.io/astral-sh/uv')}}uv{{else}}{{#if (equals packageName 'amazoncorretto')}}java{{else}}{{packageName}}{{/if}}{{/if}}"
    },
    {
      "description": "Template placeholders are not images",
      "matchManagers": [
        "docker-compose"
      ],
      "matchFileNames": [
        "templates/**"
      ],
      "enabled": false
    }
  ]
}
