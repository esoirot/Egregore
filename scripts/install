#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPTS_DIR="$REPO_ROOT/scripts"

echo
echo "======================================"
echo " Development Environment Setup"
echo "======================================"
echo
echo "Repository: $REPO_ROOT"
echo

fail() {
    echo
    echo "ERROR: $1"
    echo
    exit 1
}

check_command() {
    local command_name="$1"

    if command -v "$command_name" >/dev/null 2>&1; then
        echo "✓ $command_name"
    else
        fail "$command_name is not installed or is not available in PATH."
    fi
}

echo "Checking prerequisites..."
echo

check_command git
check_command docker

echo "✓ Docker Compose"
if ! docker compose version >/dev/null 2>&1; then
    fail "Docker Compose is not available. Install the Docker Compose plugin first."
fi

echo "✓ Docker daemon"

if ! docker info >/dev/null 2>&1; then
    fail "Docker is installed, but the Docker daemon is not accessible.

Make sure Docker is running and that your user can run Docker without sudo."
fi

echo
echo "Configuring shell environment..."

PATH_LINE='export PATH="$HOME/dev-environment/scripts:$PATH"'

if ! grep -qxF "$PATH_LINE" "$HOME/.bashrc" 2>/dev/null; then
    echo "$PATH_LINE" >> "$HOME/.bashrc"
    echo "✓ Added dev-environment/scripts to ~/.bashrc"
else
    echo "✓ PATH already configured"
fi

export PATH="$SCRIPTS_DIR:$PATH"

echo
echo "Validating project generator..."

if [[ ! -x "$SCRIPTS_DIR/new-project" ]]; then
    fail "scripts/new-project is missing or is not executable."
fi

echo "✓ new-project"

BUILT_TEMPLATES=()

for TEMPLATE_DIR in "$REPO_ROOT"/templates/*/; do
    TEMPLATE_DIR="${TEMPLATE_DIR%/}"
    TEMPLATE="$(basename "$TEMPLATE_DIR")"

    [[ -f "$TEMPLATE_DIR/template.env" ]] || continue

    IMAGE=""
    SERVICE=""
    source "$TEMPLATE_DIR/template.env"

    if [[ -z "$IMAGE" || -z "$SERVICE" ]]; then
        fail "templates/$TEMPLATE/template.env must define IMAGE and SERVICE."
    fi

    if [[ ! -d "$TEMPLATE_DIR/project" ]]; then
        fail "templates/$TEMPLATE/project/ is missing."
    fi

    echo
    echo "Building $TEMPLATE development image ($IMAGE)..."
    echo

    docker build -t "$IMAGE" "$TEMPLATE_DIR"

    echo
    echo "Validating $TEMPLATE environment..."
    echo

    CONTAINER_USER="$(docker run --rm "$IMAGE" whoami)"
    echo "✓ Container user: $CONTAINER_USER"

    if [[ "$CONTAINER_USER" != "dev" ]]; then
        fail "$IMAGE is not running as the expected non-root user."
    fi

    if [[ -x "$TEMPLATE_DIR/validate" ]]; then
        "$TEMPLATE_DIR/validate" "$IMAGE" || fail "templates/$TEMPLATE/validate failed."
    fi

    BUILT_TEMPLATES+=("$TEMPLATE  ->  $IMAGE")
done

if [[ ${#BUILT_TEMPLATES[@]} -eq 0 ]]; then
    fail "No templates found in templates/."
fi

echo
echo "======================================"
echo " Development environment is ready"
echo "======================================"
echo
echo "Templates:"
for ENTRY in "${BUILT_TEMPLATES[@]}"; do
    echo "  $ENTRY"
done
echo
echo "CLI:"
echo "  new-project <template> <project-name>"
echo
echo "Example:"
echo "  new-project node my-project"
echo
echo "If this is your first installation, reload your shell with:"
echo "  source ~/.bashrc"
echo
