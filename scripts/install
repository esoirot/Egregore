#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPTS_DIR="$REPO_ROOT/scripts"

echo
echo "======================================"
echo " Development Environment Setup"
echo "======================================"
echo
echo "Repository: $REPO_ROOT"
echo

fail() {
    echo
    echo "ERROR: $1"
    echo
    exit 1
}

check_command() {
    local command_name="$1"

    if command -v "$command_name" >/dev/null 2>&1; then
        echo "✓ $command_name"
    else
        fail "$command_name is not installed or is not available in PATH."
    fi
}

echo "Checking prerequisites..."
echo

check_command git
check_command docker

echo "✓ Docker Compose"
if ! docker compose version >/dev/null 2>&1; then
    fail "Docker Compose is not available. Run scripts/bootstrap first."
fi

echo "✓ Docker daemon"

if ! docker info >/dev/null 2>&1; then
    fail "Docker is installed, but the Docker daemon is not accessible.

Run scripts/bootstrap, or make sure Docker is running and your user can run Docker without sudo."
fi

echo
echo "Configuring shell environment..."

PATH_LINE="export PATH=\"$SCRIPTS_DIR:\$PATH\""

if ! grep -qxF "$PATH_LINE" "$HOME/.bashrc" 2>/dev/null; then
    echo "$PATH_LINE" >> "$HOME/.bashrc"
    echo "✓ Added $SCRIPTS_DIR to ~/.bashrc"
else
    echo "✓ PATH already configured"
fi

export PATH="$SCRIPTS_DIR:$PATH"

echo
echo "Validating scripts..."

for SCRIPT in new-project dev; do
    [[ -x "$SCRIPTS_DIR/$SCRIPT" ]] || fail "scripts/$SCRIPT is missing or is not executable."
    echo "✓ $SCRIPT"
done

BUILT_IMAGES=()

for IMAGE_DIR in "$REPO_ROOT"/images/*/; do
    IMAGE_DIR="${IMAGE_DIR%/}"
    NAME="$(basename "$IMAGE_DIR")"

    IMAGE=""
    source "$IMAGE_DIR/image.env"
    [[ -n "$IMAGE" ]] || fail "images/$NAME/image.env must define IMAGE."

    echo

    # Registry pull is disabled unless PULL_IMAGES=1; the image is built locally.
    if [[ "${PULL_IMAGES:-0}" == "1" ]] && docker pull "$IMAGE"; then
        echo "✓ Pulled $IMAGE"
    else
        echo "Building $NAME image ($IMAGE)..."
        echo
        docker build -t "$IMAGE" "$IMAGE_DIR"
    fi

    if [[ -x "$IMAGE_DIR/validate" ]]; then
        echo
        echo "Validating $NAME..."
        "$IMAGE_DIR/validate" "$IMAGE" || fail "images/$NAME/validate failed."
    fi

    BUILT_IMAGES+=("$NAME  ->  $IMAGE")
done

echo
echo "======================================"
echo " Development environment is ready"
echo "======================================"
echo
echo "Images:"
for ENTRY in "${BUILT_IMAGES[@]}"; do
    echo "  $ENTRY"
done
echo
echo "Templates:"
for DIR in "$REPO_ROOT"/templates/*/; do
    [[ -d "$DIR/scaffold" ]] && echo "  $(basename "$DIR")"
done
echo
echo "CLI:"
echo "  new-project <template> <project-name>"
echo "  dev up | shell | exec <cmd> | down"
echo
echo "Example:"
echo "  new-project node my-project"
echo
echo "If this is your first installation, reload your shell with:"
echo "  source ~/.bashrc"
echo
