#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
TEMPLATES_DIR="$REPO_ROOT/templates"
PROJECTS_DIR="${PROJECTS_DIR:-$HOME/projects}"

TEMPLATE="${1:-}"
PROJECT_NAME="${2:-}"
FROM_REPO=""

usage() {
    echo "Usage: new-project <template> <project-name> [--from <git-url|path>]"
    echo
    echo "  --from    clone an existing repository and add the template's dev environment"
    echo "            around it; files from the repository are never overwritten"
    echo
    echo "Available templates:"
    for dir in "$TEMPLATES_DIR"/*/; do
        [[ -d "$dir/scaffold" ]] && echo "  $(basename "$dir")"
    done
    echo
    echo "Project names allow lowercase letters, numbers, underscores and hyphens."
    exit 1
}

if [[ $# -gt 2 ]]; then
    [[ $# -eq 4 && "$3" == "--from" && -n "$4" ]] || usage
    FROM_REPO="$4"
fi

if [[ ! "$TEMPLATE" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    usage
fi

TEMPLATE_DIR="$TEMPLATES_DIR/$TEMPLATE"

if [[ ! -d "$TEMPLATE_DIR/scaffold" ]]; then
    echo "Error: unknown template: $TEMPLATE"
    echo
    usage
fi

# Lowercase only: the name is also the compose project name.
if [[ ! "$PROJECT_NAME" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    usage
fi

# Provides IMAGE (the shared base image).
IMAGE=""
source "$REPO_ROOT/images/base/image.env"

PROJECT_ROOT="$PROJECTS_DIR/$PROJECT_NAME"

if [[ -e "$PROJECT_ROOT" ]]; then
    echo "Error: project already exists: $PROJECT_ROOT"
    exit 1
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "Error: $IMAGE is not available locally."
    echo "Build it by running scripts/install from this repository."
    exit 1
fi

if [[ -n "$FROM_REPO" ]]; then
    git clone "$FROM_REPO" "$PROJECT_ROOT"
else
    mkdir -p "$PROJECT_ROOT"
fi

cd "$PROJECT_ROOT"

# scaffold/ is the dev environment; starter/ (sample app, production stub, README)
# only goes into new projects, never into an adopted repository.
SOURCES=("$TEMPLATE_DIR/scaffold")
if [[ -z "$FROM_REPO" && -d "$TEMPLATE_DIR/starter" ]]; then
    SOURCES+=("$TEMPLATE_DIR/starter")
fi

# Copy template files the project does not have yet; existing files always win.
ADDED=()
for SOURCE in "${SOURCES[@]}"; do
    while IFS= read -r -d '' FILE; do
        FILE="${FILE#./}"
        [[ -e "$FILE" ]] && continue
        mkdir -p "$(dirname "$FILE")"
        cp -p "$SOURCE/$FILE" "$FILE"
        ADDED+=("$FILE")
    done < <(cd "$SOURCE" && find . -type f -print0 | sort -z)
done

# Only in copied files: repository code may contain the same placeholders.
for FILE in "${ADDED[@]}"; do
    sed -i -e "s|{{PROJECT_NAME}}|$PROJECT_NAME|g" -e "s|{{IMAGE}}|$IMAGE|g" "$FILE"
done

if [[ " ${ADDED[*]} " == *" .devcontainer/devcontainer.json "* ]]; then
    # Match the dev container to the repository's runtime version files.
    if [[ -x "$TEMPLATE_DIR/adopt" ]]; then
        "$TEMPLATE_DIR/adopt" "$PROJECT_ROOT"
    fi
else
    echo "Note: kept the repository's .devcontainer/devcontainer.json; it may not follow the $TEMPLATE template."
fi

echo "Created $TEMPLATE project: $PROJECT_ROOT"

# Seed .env so the host port is set before the first dev up (APP_PORT=<port> new-project ...).
if [[ ! -f .env && -f .env.example ]]; then
    cp .env.example .env
fi
if [[ -f .env ]]; then
    if grep -q '^APP_PORT=' .env; then
        if [[ -n "${APP_PORT:-}" ]]; then
            sed -i "s|^APP_PORT=.*|APP_PORT=$APP_PORT|" .env
        fi
    else
        [[ -z "$(tail -c 1 .env)" ]] || echo >> .env
        echo "APP_PORT=${APP_PORT:-3000}" >> .env
    fi
fi

if [[ -n "$FROM_REPO" ]]; then
    echo
    echo "Added from the $TEMPLATE template (untracked in the repository; commit them or not):"
    printf '  %s\n' "${ADDED[@]}"
fi

"$REPO_ROOT/scripts/dev" up

echo
echo "Development container started."
echo "Next:"
echo "  cd \"$PROJECT_ROOT\""
echo "  dev shell"
