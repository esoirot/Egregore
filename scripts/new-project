#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
TEMPLATES_DIR="$REPO_ROOT/templates"
PROJECTS_DIR="${PROJECTS_DIR:-$HOME/projects}"

TEMPLATE="${1:-}"
PROJECT_NAME="${2:-}"

usage() {
    echo "Usage: new-project <template> <project-name>"
    echo
    echo "Available templates:"
    for dir in "$TEMPLATES_DIR"/*/; do
        [[ -d "$dir/scaffold" ]] && echo "  $(basename "$dir")"
    done
    echo
    echo "Project names allow lowercase letters, numbers, underscores and hyphens."
    exit 1
}

if [[ ! "$TEMPLATE" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    usage
fi

TEMPLATE_DIR="$TEMPLATES_DIR/$TEMPLATE"

if [[ ! -d "$TEMPLATE_DIR/scaffold" ]]; then
    echo "Error: unknown template: $TEMPLATE"
    echo
    usage
fi

# Lowercase only: the name is also the compose project name.
if [[ ! "$PROJECT_NAME" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    usage
fi

# Provides IMAGE (the shared base image).
IMAGE=""
source "$REPO_ROOT/images/base/image.env"

PROJECT_ROOT="$PROJECTS_DIR/$PROJECT_NAME"

if [[ -e "$PROJECT_ROOT" ]]; then
    echo "Error: project already exists: $PROJECT_ROOT"
    exit 1
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "Error: $IMAGE is not available locally."
    echo "Build it by running scripts/install from this repository."
    exit 1
fi

mkdir -p "$PROJECT_ROOT"
cp -R "$TEMPLATE_DIR/scaffold/." "$PROJECT_ROOT/"

find "$PROJECT_ROOT" -type f -exec sed -i \
    -e "s|{{PROJECT_NAME}}|$PROJECT_NAME|g" \
    -e "s|{{IMAGE}}|$IMAGE|g" \
    {} +

echo "Created $TEMPLATE project: $PROJECT_ROOT"

cd "$PROJECT_ROOT"

# Seed .env so the host port is set before the first dev up (APP_PORT=<port> new-project ...).
if [[ -f .env.example ]]; then
    cp .env.example .env
    if [[ -n "${APP_PORT:-}" ]]; then
        sed -i "s|^APP_PORT=.*|APP_PORT=$APP_PORT|" .env
    fi
fi

"$REPO_ROOT/scripts/dev" up

echo
echo "Development container started."
echo "Next:"
echo "  cd \"$PROJECT_ROOT\""
echo "  dev shell"
