#!/usr/bin/env bash
# Behavior tests for `new-project` (create, --from, --with, --ide, --update / dev update).
# Runs new-project against local fixture repos, with scripts/dev stubbed out
# (records calls instead of starting containers) and `code` stubbed. Needs the base image locally.
# Usage: tests/new-project
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Under $HOME, not /tmp: the java scenario bind-mounts it into a container.
WORK="$(mktemp -d "$HOME/.egregore-test.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

# make_sandbox <dir>: copy of this repo (git-visible files only) with a stub dev script.
# The real dev script stays available as scripts/dev.real (for `dev update`).
make_sandbox() {
    mkdir -p "$1"
    # ls-files also lists tracked files deleted or moved in the working tree: keep existing ones.
    git -C "$REPO_ROOT" ls-files -co --exclude-standard \
        | while IFS= read -r f; do if [[ -e "$REPO_ROOT/$f" ]]; then echo "$f"; fi; done \
        | tar -C "$REPO_ROOT" -cf - -T - | tar -C "$1" -xf -
    mv "$1/scripts/dev" "$1/scripts/dev.real"
    printf '#!/usr/bin/env bash\necho "$PWD $*" >> "$DEV_LOG"\n' > "$1/scripts/dev"
    chmod +x "$1/scripts/dev"
}

SANDBOX="$WORK/egregore"
make_sandbox "$SANDBOX"

# Stub `code` (VS Code CLI): records where it was opened.
mkdir -p "$WORK/bin"
printf '#!/usr/bin/env bash\necho "$PWD $*" >> "$CODE_LOG"\n' > "$WORK/bin/code"
chmod +x "$WORK/bin/code"
export CODE_LOG="$WORK/code.log"
touch "$CODE_LOG"

NEW_PROJECT="$SANDBOX/scripts/new-project"
export PROJECTS_DIR="$WORK/projects"
export DEV_LOG="$WORK/dev.log"
mkdir -p "$PROJECTS_DIR"

source "$SANDBOX/images/base/image.env"
BASE_IMAGE="$IMAGE"
source "$SANDBOX/images/devcontainer-cli/image.env"
CLI_IMAGE="$IMAGE"

# template_port <dir>: the app's container port for a template directory (its port file, else 3000).
template_port() {
    if [[ -f "$1/port" ]]; then cat "$1/port"; else echo 3000; fi
}

# template_names: every template of the sandbox (a directory with a scaffold/).
template_names() {
    local d
    for d in "$SANDBOX"/templates/*/; do
        if [[ -d "$d/scaffold" ]]; then basename "$d"; fi
    done
}

# make_repo <dir> <path>=<content>... : a committed git repo with the given files.
make_repo() {
    local dir="$1"; shift
    mkdir -p "$dir"
    git -C "$dir" init -q
    local spec path
    for spec in "$@"; do
        path="${spec%%=*}"
        mkdir -p "$dir/$(dirname "$path")"
        printf '%s\n' "${spec#*=}" > "$dir/$path"
    done
    git -C "$dir" add -A
    git -C "$dir" -c user.name=test -c user.email=test@example.com commit -q -m init
}

# jsonc_valid <file>: strict JSON once // comment lines are dropped (devcontainer files are JSONC).
jsonc_valid() {
    sed '/^[[:space:]]*\/\//d' "$1" | python3 -m json.tool > /dev/null
}

feature_version() { # feature_version <project> <feature-key-fragment>
    sed -n "/$2/,/}/ s|.*\"version\": \"\([^\"]*\)\".*|\1|p" "$1/.devcontainer/devcontainer.json" | head -1
}

PASSED=0
FAILED=0
# fails <cmd...>: succeed only if the command fails (`! cmd` does not trip set -e).
fails() {
    if "$@"; then return 1; fi
}

scenario() {
    local name="$1" rc; shift
    # Not inside `if`: set -e is ignored in conditions, even in subshells.
    set +e
    ( set -euo pipefail; "$@" ) > "$WORK/out" 2>&1
    rc=$?
    set -e
    if [[ "$rc" -eq 0 ]]; then
        PASSED=$((PASSED + 1)); echo "✓ $name"
    else
        FAILED=$((FAILED + 1)); echo "✗ $name"; sed 's/^/    /' "$WORK/out"
    fi
}

repo_files_never_overwritten() {
    make_repo "$WORK/src/keep" "README.md=# Mine" ".gitignore=my-ignore" "justfile=mine:" "Gemfile=x"
    "$NEW_PROJECT" rails keep --from "$WORK/src/keep"
    local f
    for f in README.md .gitignore justfile; do
        cmp "$WORK/src/keep/$f" "$PROJECTS_DIR/keep/$f"
    done
}

placeholders_in_repo_code_untouched() {
    make_repo "$WORK/src/tpl" "views/page.hbs={{PROJECT_NAME}} {{IMAGE}}" "Gemfile=x"
    "$NEW_PROJECT" rails tpl --from "$WORK/src/tpl"
    local p="$PROJECTS_DIR/tpl"
    [[ "$(cat "$p/views/page.hbs")" == "{{PROJECT_NAME}} {{IMAGE}}" ]]
    grep -qx "name: tpl" "$p/compose.yaml"
    grep -q "image: $BASE_IMAGE" "$p/compose.yaml"
}

app_port_with_repo_env_example() {
    make_repo "$WORK/src/envx" ".env.example=FOO=bar" "Gemfile=x"
    APP_PORT=3100 "$NEW_PROJECT" rails envx --from "$WORK/src/envx"
    grep -qx "FOO=bar" "$PROJECTS_DIR/envx/.env"
    grep -qx "APP_PORT=3100" "$PROJECTS_DIR/envx/.env"
}

app_port_defaults_when_repo_example_lacks_it() {
    own_projects_dir envd
    make_repo "$WORK/src/envd" ".env.example=FOO=bar" "Gemfile=x"
    "$NEW_PROJECT" rails envd --from "$WORK/src/envd"
    # 3000, unless something on this machine already listens there.
    local want=3000
    while (exec 3<> "/dev/tcp/127.0.0.1/$want") 2> /dev/null; do want=$((want + 1)); done
    grep -qx "APP_PORT=$want" "$PROJECTS_DIR/envd/.env"
}

repo_devcontainer_is_kept_and_reported() {
    make_repo "$WORK/src/own" ".devcontainer/devcontainer.json={\"name\": \"theirs\"}" ".ruby-version=3.2.0" "Gemfile=x"
    "$NEW_PROJECT" rails own --from "$WORK/src/own" > "$WORK/own.out"
    [[ "$(cat "$PROJECTS_DIR/own/.devcontainer/devcontainer.json")" == '{"name": "theirs"}' ]]
    grep -q "kept the repository's .devcontainer/devcontainer.json" "$WORK/own.out"
}

added_files_are_listed() {
    make_repo "$WORK/src/list" "Gemfile=x"
    "$NEW_PROJECT" rails list --from "$WORK/src/list" > "$WORK/list.out"
    grep -q "compose.yaml" "$WORK/list.out"
    grep -q ".devcontainer/devcontainer.json" "$WORK/list.out"
    [[ -n "$(git -C "$PROJECTS_DIR/list" status --porcelain -- compose.yaml)" ]]
}

existing_target_fails_without_cloning() {
    make_repo "$WORK/src/dup" "Gemfile=x"
    mkdir -p "$PROJECTS_DIR/dup"
    fails "$NEW_PROJECT" rails dup --from "$WORK/src/dup" > "$WORK/dup.out" 2>&1
    grep -q "project already exists" "$WORK/dup.out"
    [[ -z "$(ls -A "$PROJECTS_DIR/dup")" ]]
}

clone_failure_leaves_nothing() {
    fails "$NEW_PROJECT" rails gone --from "$WORK/src/does-not-exist" > /dev/null 2>&1
    [[ ! -e "$PROJECTS_DIR/gone" ]]
}

plain_new_project_unchanged() {
    APP_PORT=3200 "$NEW_PROJECT" node plain
    local p="$PROJECTS_DIR/plain"
    [[ ! -e "$p/.git" ]]
    [[ -f "$p/package.json" && -f "$p/src/app.js" && -f "$p/.devcontainer/devcontainer.json" ]]
    grep -qx "name: plain" "$p/compose.yaml"
    grep -q '"name": "plain"' "$p/package.json"
    fails grep -rq "{{PROJECT_NAME}}\|{{IMAGE}}" "$p"
    grep -qx "APP_PORT=3200" "$p/.env"
    grep -qx "$p up" "$DEV_LOG"
}

# just_dry_run <project> <recipe>: the command a recipe would run, resolved inside the base image.
# just prints it on stderr; `*args` recipes render with a trailing space.
just_dry_run() {
    docker run --rm -v "$1:/workspace" "$BASE_IMAGE" just --dry-run "$2" 2>&1 | sed 's/[[:space:]]*$//'
}

adopted_repo_gets_no_sample_app() {
    make_repo "$WORK/src/napp" "package.json={}" "index.js=//"
    "$NEW_PROJECT" node napp --from "$WORK/src/napp"
    make_repo "$WORK/src/papp" "pyproject.toml=[project]" "main.py=#"
    "$NEW_PROJECT" fastapi papp --from "$WORK/src/papp"
    local f
    for f in napp/src napp/test napp/biome.json napp/Dockerfile napp/README.md \
             papp/app papp/tests papp/.python-version papp/Dockerfile papp/README.md; do
        [[ ! -e "$PROJECTS_DIR/$f" ]] || { echo "unexpected sample file: $f"; return 1; }
    done
    [[ -f "$PROJECTS_DIR/napp/compose.yaml" && -f "$PROJECTS_DIR/papp/justfile" ]]
}

new_fastapi_project_gets_starter() {
    "$NEW_PROJECT" fastapi fresh
    local p="$PROJECTS_DIR/fresh"
    [[ -f "$p/app/main.py" && -f "$p/tests/test_main.py" && -f "$p/Dockerfile" && -f "$p/.python-version" ]]
    grep -q 'name = "fresh"' "$p/pyproject.toml"
    grep -q "^# fresh" "$p/README.md"
}

services_on_new_project() {
    "$NEW_PROJECT" node svc --with postgres,redis
    local p="$PROJECTS_DIR/svc"
    [[ -f "$p/compose.postgres.yaml" && -f "$p/compose.redis.yaml" ]]
    grep -q '^include:' "$p/compose.yaml"
    grep -qx '  - compose.postgres.yaml' "$p/compose.yaml"
    grep -qx '  - compose.redis.yaml' "$p/compose.yaml"
    grep -q '@sha256:' "$p/compose.postgres.yaml"
    local f
    for f in .env .env.example; do
        grep -qx 'DATABASE_URL=postgres://dev:dev@postgres:5432/dev' "$p/$f"
        grep -qx 'PGHOST=postgres' "$p/$f"
        grep -qx 'REDIS_URL=redis://redis:6379/0' "$p/$f"
    done
}

unknown_service_fails() {
    fails "$NEW_PROJECT" node nosvc --with mongo > "$WORK/nosvc.out" 2>&1
    grep -q "postgres" "$WORK/nosvc.out"
    [[ ! -e "$PROJECTS_DIR/nosvc" ]]
}

services_with_adopted_repo() {
    make_repo "$WORK/src/svcrepo" ".env.example=FOO=bar" "package.json={}"
    "$NEW_PROJECT" node svcrepo --with postgres --from "$WORK/src/svcrepo"
    local p="$PROJECTS_DIR/svcrepo"
    cmp "$WORK/src/svcrepo/.env.example" "$p/.env.example"
    grep -qx 'DATABASE_URL=postgres://dev:dev@postgres:5432/dev' "$p/.env"
    grep -qx 'FOO=bar' "$p/.env"
    grep -qx '  - compose.postgres.yaml' "$p/compose.yaml"
}

env_reaches_the_container() {
    own_projects_dir envc
    make_repo "$WORK/src/envc" ".env.example=APP_PORT=3640"
    "$NEW_PROJECT" fastapi envc --from "$WORK/src/envc"
    docker compose -f "$PROJECTS_DIR/envc/compose.yaml" config --format json \
        | python3 -c 'import json,sys; assert json.load(sys.stdin)["services"]["dev"]["environment"]["APP_PORT"] == "3640"'
}

ide_vscode_adds_extensions_and_opens() {
    PATH="$WORK/bin:$PATH" "$NEW_PROJECT" fastapi idevs --ide=vscode
    local p="$PROJECTS_DIR/idevs"
    jsonc_valid "$p/.devcontainer/devcontainer.json"
    grep -q '"ms-python.python"' "$p/.devcontainer/devcontainer.json"
    grep -q '"charliermarsh.ruff"' "$p/.devcontainer/devcontainer.json"
    grep -qx "$p ." "$CODE_LOG"
}

ide_vscode_without_code_gives_hint() {
    # A PATH with the tools new-project needs, but no `code`.
    local bin tool
    bin="$(mktemp -d "$WORK/nocode.XXXX")"
    for tool in bash env git docker sed grep find sort cp mkdir dirname basename cat tail head \
                mktemp rm sha256sum cut paste readlink mv tr touch chmod printf; do
        if command -v "$tool" > /dev/null; then ln -sf "$(command -v "$tool")" "$bin/$tool"; fi
    done
    PATH="$bin" "$NEW_PROJECT" node idenocode --ide=vscode > "$WORK/nocode.out" 2>&1
    [[ -f "$PROJECTS_DIR/idenocode/compose.yaml" ]]
    grep -q "code \." "$WORK/nocode.out"
}

unsupported_ide_fails() {
    fails "$NEW_PROJECT" node ideemacs --ide=emacs > "$WORK/emacs.out" 2>&1
    grep -q "vscode" "$WORK/emacs.out"
    [[ ! -e "$PROJECTS_DIR/ideemacs" ]]
}

render_failure_creates_nothing() {
    local sb="$WORK/sb-render"; make_sandbox "$sb"
    rm "$sb/templates/node/vscode-extensions"
    fails "$sb/scripts/new-project" node rfail --ide=vscode > /dev/null 2>&1
    [[ ! -e "$PROJECTS_DIR/rfail" ]]
    make_repo "$WORK/src/rfail" "package.json={}"
    fails "$sb/scripts/new-project" node rfail --from "$WORK/src/rfail" --ide=vscode > /dev/null 2>&1
    [[ ! -e "$PROJECTS_DIR/rfail" ]]
}

options_in_any_order() {
    make_repo "$WORK/src/order" "Gemfile=x"
    "$NEW_PROJECT" rails order --with redis --from "$WORK/src/order"
    [[ "$(git -C "$PROJECTS_DIR/order" log --format=%s)" == "init" ]]
    [[ -f "$PROJECTS_DIR/order/compose.redis.yaml" ]]
}

lock_is_written() {
    PATH="$WORK/bin:$PATH" "$NEW_PROJECT" node locked --with redis --ide=vscode
    local lock="$PROJECTS_DIR/locked/.devcontainer/template.lock"
    grep -qx "template node" "$lock"
    grep -qx "name locked" "$lock"
    grep -qx "services redis" "$lock"
    grep -qx "ide vscode" "$lock"
    grep -qE "^file [0-9a-f]{64} compose.yaml$" "$lock"
    fails grep -q " src/app.js$" "$lock"
}

# --- template contract --------------------------------------------------------

# read_configuration <project>: the configuration the Dev Containers CLI resolves (JSON).
read_configuration() {
    docker run --rm --user "$(id -u):$(id -g)" --group-add "$(stat -c %g /var/run/docker.sock)" -e HOME=/tmp \
        -v /var/run/docker.sock:/var/run/docker.sock -v "$1:$1" -w "$1" \
        "$CLI_IMAGE" read-configuration --workspace-folder "$1" 2>/dev/null
}

# check_contract <sandbox> <template>: projects made from the template (with and without
# --ide=vscode) keep the team contract. Prints the broken rule on failure.
check_contract() {
    local sb="$1" t="$2" dir="$1/templates/$2" ide p recipes r
    [[ -s "$dir/vscode-extensions" ]] || { echo "$t: vscode-extensions missing or empty"; return 1; }
    if [[ -e "$dir/adopt" && ! -x "$dir/adopt" ]]; then echo "$t: adopt is not executable"; return 1; fi
    for ide in "" vscode; do
        p="$PROJECTS_DIR/${sb##*/}-$t${ide:+-$ide}"
        PATH="$WORK/bin:$PATH" "$sb/scripts/new-project" "$t" "${p##*/}" ${ide:+"--ide=$ide"} > /dev/null \
            || { echo "$t: new-project failed"; return 1; }
        read_configuration "$p" | python3 -c 'import json, sys
c = json.load(sys.stdin)["configuration"]
assert (c.get("service"), c.get("remoteUser"), c.get("workspaceFolder")) == ("dev", "dev", "/workspace")
if sys.argv[1]:
    assert c["customizations"]["vscode"]["extensions"] == open(sys.argv[2]).read().split()' "$ide" "$dir/vscode-extensions" \
            || { echo "$t${ide:+ --ide=$ide}: devcontainer.json does not resolve to service dev, remoteUser dev, /workspace${ide:+ and vscode-extensions}"; return 1; }
    done
    docker compose -f "$p/compose.yaml" config --format json | python3 -c 'import json, sys
dev = json.load(sys.stdin)["services"]["dev"]
assert dev["image"] == sys.argv[1] and "APP_PORT" in dev.get("environment", {})
assert [p["target"] for p in dev["ports"]] == [int(sys.argv[2])]' "$BASE_IMAGE" "$(template_port "$dir")" \
        || { echo "$t: compose service dev must use the base image, load .env (env_file) and publish port $(template_port "$dir")"; return 1; }
    head -1 "$p/justfile" | grep -q '^# Team command contract' \
        || { echo "$t: justfile lacks the '# Team command contract' header (adopt variants rely on it)"; return 1; }
    recipes=" $(docker run --rm -v "$p:/workspace" "$BASE_IMAGE" just --summary) "
    for r in install dev test lint build; do
        [[ "$recipes" == *" $r "* ]] || { echo "$t: justfile lacks recipe $r"; return 1; }
    done
}

contract_check_catches_missing_recipe() {
    local sb="$WORK/sb-norecipe"; make_sandbox "$sb"
    sed -i 's/^test \*args:/check *args:/' "$sb/templates/node/scaffold/justfile"
    check_contract "$sb" node > "$WORK/norecipe.out" && return 1
    grep -q "node: justfile lacks recipe test" "$WORK/norecipe.out"
}

contract_check_catches_trailing_blank_line() {
    local sb="$WORK/sb-blank"; make_sandbox "$sb"
    echo >> "$sb/templates/node/scaffold/.devcontainer/devcontainer.json"
    check_contract "$sb" node > "$WORK/blank.out" && return 1
    grep -q "node --ide=vscode: devcontainer.json" "$WORK/blank.out"
}

# --- shared scaffold (templates/_shared) -----------------------------------

shared_files_reach_every_template() {
    local t f
    for t in $(template_names); do
        "$NEW_PROJECT" "$t" "shared-$t"
        for f in compose.yaml .env.example; do
            # A template with its own services (compose.template.yaml) adds an include: block on top.
            [[ "$(awk 'NR == 1 && /^include:$/ { skip = 1 } skip { if (/^$/) skip = 0; next } 1' "$PROJECTS_DIR/shared-$t/$f")" == \
               "$(sed -e "s|{{PROJECT_NAME}}|shared-$t|g" -e "s|{{IMAGE}}|$BASE_IMAGE|g" \
                      -e "s|{{PORT}}|$(template_port "$SANDBOX/templates/$t")|g" "$SANDBOX/templates/_shared/$f"
                  # a template's own variables (templates/<name>/env) follow the shared ones
                  if [[ "$f" == .env.example && -f "$SANDBOX/templates/$t/env" ]]; then
                      printf '\n# %s template\n' "$t"; cat "$SANDBOX/templates/$t/env"
                  fi)" ]] \
                || { echo "$t: $f differs from templates/_shared/$f"; return 1; }
        done
    done
}

template_file_wins_over_shared() {
    local sb="$WORK/sb-override"; make_sandbox "$sb"
    printf 'name: {{PROJECT_NAME}}\n# node only\n' > "$sb/templates/node/scaffold/compose.yaml"
    "$sb/scripts/new-project" node ovr
    grep -qx "# node only" "$PROJECTS_DIR/ovr/compose.yaml"
    "$sb/scripts/new-project" fastapi ovr2
    fails grep -q "# node only" "$PROJECTS_DIR/ovr2/compose.yaml"
}

shared_is_not_a_template() {
    fails "$NEW_PROJECT" _shared shr > "$WORK/shr.out" 2>&1
    [[ ! -e "$PROJECTS_DIR/shr" ]]
    fails "$NEW_PROJECT" > "$WORK/usage.out" 2>&1
    grep -qx "  node" "$WORK/usage.out"
    fails grep -q "_shared" "$WORK/usage.out"
}

update_brings_shared_fix_to_every_template() {
    local sb="$WORK/sb-shared"; make_sandbox "$sb"
    "$sb/scripts/new-project" node shu1
    "$sb/scripts/new-project" rails shu2
    echo "# shared fix" >> "$sb/templates/_shared/compose.yaml"
    local p
    for p in shu1 shu2; do
        (cd "$PROJECTS_DIR/$p" && "$sb/scripts/dev.real" update) > /dev/null
        grep -qx "# shared fix" "$PROJECTS_DIR/$p/compose.yaml"
    done
}

# --- template services (scaffold/compose.template.yaml) -----------------------

# given_template_services <sandbox>: the node template gets an extra service.
given_template_services() {
    printf 'services:\n  extra:\n    image: {{IMAGE}}\n    command: sleep infinity\n    labels:\n      project: {{PROJECT_NAME}}\n' \
        > "$1/templates/node/scaffold/compose.template.yaml"
}

template_services_are_included() {
    local sb="$WORK/sb-tsvc"; make_sandbox "$sb"; given_template_services "$sb"
    "$sb/scripts/new-project" node tsvc
    local p="$PROJECTS_DIR/tsvc"
    grep -qx '  - compose.template.yaml' "$p/compose.yaml"
    grep -q "image: $BASE_IMAGE" "$p/compose.template.yaml"
    grep -q "project: tsvc" "$p/compose.template.yaml"
    grep -qE "^file [0-9a-f]{64} compose.template.yaml$" "$p/.devcontainer/template.lock"
    [[ "$(docker compose -f "$p/compose.yaml" config --services | sort | paste -sd' ')" == "dev extra" ]]
}

template_services_come_before_with_services() {
    local sb="$WORK/sb-tsvc2"; make_sandbox "$sb"; given_template_services "$sb"
    "$sb/scripts/new-project" node tsvc2 --with redis
    [[ "$(sed -n '/^include:/,/^$/p' "$PROJECTS_DIR/tsvc2/compose.yaml")" == \
       "$(printf 'include:\n  - compose.template.yaml\n  - compose.redis.yaml\n')" ]]
}

update_brings_template_services_change() {
    local sb="$WORK/sb-tsvc3"; make_sandbox "$sb"; given_template_services "$sb"
    "$sb/scripts/new-project" node tsvc3
    echo "    init: true" >> "$sb/templates/node/scaffold/compose.template.yaml"
    (cd "$PROJECTS_DIR/tsvc3" && "$sb/scripts/dev.real" update) > /dev/null
    grep -qx "    init: true" "$PROJECTS_DIR/tsvc3/compose.template.yaml"
}

no_template_services_no_include() {
    "$NEW_PROJECT" node notsvc
    fails grep -q '^include:' "$PROJECTS_DIR/notsvc/compose.yaml"
}

# --- template variables (templates/<name>/env) -------------------------------

