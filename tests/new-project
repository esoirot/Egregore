# Each template's own scenarios (adopt, env-skip), kept next to it in templates/<name>/test.
for f in "$SANDBOX"/templates/*/test; do
    if [[ ! -f "$f" ]]; then continue; fi
    ran=$((PASSED + FAILED))
    # shellcheck source=/dev/null  # checked on its own in CI
    source "$f"
    if [[ $((PASSED + FAILED)) -eq $ran ]]; then
        FAILED=$((FAILED + 1)); echo "✗ ${f#"$SANDBOX"/} runs no scenario (missing scenario lines?)"
    fi
done

echo
echo "$PASSED passed, $FAILED failed"
[[ "$FAILED" -eq 0 ]]
