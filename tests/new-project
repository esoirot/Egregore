# --- host port (APP_PORT) -----------------------------------------------------
# Each scenario gets its own projects folder: every project's .env claims a port.

own_projects_dir() {
    export PROJECTS_DIR="$WORK/ports-$1"
    mkdir -p "$PROJECTS_DIR"
}

# listen_on <port>: hold the port on 127.0.0.1 until the scenario ends (prints the pid).
listen_on() {
    python3 -c 'import socket, sys, time
s = socket.socket(); s.bind(("127.0.0.1", int(sys.argv[1]))); s.listen(); time.sleep(60)' "$1" > /dev/null 2>&1 &
    echo $!
    sleep 0.3
}

port_claimed_by_stopped_project_is_skipped() {
    own_projects_dir claim
    make_repo "$WORK/src/claim" ".env.example=APP_PORT=3610" "package.json={}"
    "$NEW_PROJECT" node claim1 --from "$WORK/src/claim"
    "$NEW_PROJECT" node claim2 --from "$WORK/src/claim" > "$WORK/claim.out"
    grep -qx "APP_PORT=3610" "$PROJECTS_DIR/claim1/.env"
    grep -qx "APP_PORT=3611" "$PROJECTS_DIR/claim2/.env"
    grep -q "3611 (3610 is taken)" "$WORK/claim.out"
}

port_in_use_on_host_is_skipped() {
    own_projects_dir listen
    local pid; pid="$(listen_on 3620)"
    make_repo "$WORK/src/listen" ".env.example=APP_PORT=3620" "package.json={}"
    "$NEW_PROJECT" node listen --from "$WORK/src/listen"
    kill "$pid"
    grep -qx "APP_PORT=3621" "$PROJECTS_DIR/listen/.env"
}

explicit_app_port_is_used_even_if_taken() {
    own_projects_dir explicit
    local pid; pid="$(listen_on 3630)"
    APP_PORT=3630 "$NEW_PROJECT" node explicit
    kill "$pid"
    grep -qx "APP_PORT=3630" "$PROJECTS_DIR/explicit/.env"
}

repo_own_env_port_is_kept() {
    own_projects_dir ownenv
    make_repo "$WORK/src/claimer" ".env.example=APP_PORT=4000" "package.json={}"
    "$NEW_PROJECT" node claimer --from "$WORK/src/claimer"
    make_repo "$WORK/src/ownenv" ".env=APP_PORT=4000" "package.json={}"
    "$NEW_PROJECT" node ownenv --from "$WORK/src/ownenv"
    grep -qx "APP_PORT=4000" "$PROJECTS_DIR/ownenv/.env"
}

no_free_port_leaves_project_stopped_with_hint() {
    own_projects_dir full
    local i
    for i in $(seq 0 999); do
        mkdir -p "$PROJECTS_DIR/other$i"; echo "APP_PORT=$((3700 + i))" > "$PROJECTS_DIR/other$i/.env"
    done
    make_repo "$WORK/src/full" ".env.example=APP_PORT=3700" "package.json={}"
    fails "$NEW_PROJECT" node full --from "$WORK/src/full" > "$WORK/full.out" 2>&1
    grep -q "APP_PORT" "$WORK/full.out"
    fails grep -q "^$PROJECTS_DIR/full up" "$DEV_LOG"
}

# --- app port (templates/<name>/port) ---------------------------------------

port_file_sets_container_port() {
    local sb="$WORK/sb-port"; make_sandbox "$sb"
    echo 8000 > "$sb/templates/node/port"
    printf '\n# app port {{PORT}}\n' >> "$sb/templates/node/scaffold/justfile"
    "$sb/scripts/new-project" node p8000
    local p="$PROJECTS_DIR/p8000"
    grep -qF '"127.0.0.1:${APP_PORT:-3000}:8000"' "$p/compose.yaml"
    grep -q "port 8000 in the container" "$p/.env.example"
    grep -qx "# app port 8000" "$p/justfile"
    check_contract "$sb" node
}

invalid_port_fails_and_creates_nothing() {
    local sb="$WORK/sb-badport"; make_sandbox "$sb"
    local bad
    for bad in abc 0 70000 "80 81"; do
        echo "$bad" > "$sb/templates/node/port"
        fails "$sb/scripts/new-project" node badport > "$WORK/badport.out" 2>&1
        grep -q "templates/node/port" "$WORK/badport.out" || { echo "no file named for: $bad"; return 1; }
        [[ ! -e "$PROJECTS_DIR/badport" ]] || { echo "project created for: $bad"; return 1; }
    done
}

update_brings_port_change() {
    local sb="$WORK/sb-portupd"; make_sandbox "$sb"
    "$sb/scripts/new-project" node portupd
    echo 8000 > "$sb/templates/node/port"
    (cd "$PROJECTS_DIR/portupd" && "$sb/scripts/dev.real" update) > /dev/null
    grep -qF '"127.0.0.1:${APP_PORT:-3000}:8000"' "$PROJECTS_DIR/portupd/compose.yaml"
}

# --- dev update -------------------------------------------------------------
# Each scenario gets its own sandbox, so changing its templates does not leak.

update_replaces_untouched_files() {
    local sb="$WORK/sb-untouched"; make_sandbox "$sb"
    "$sb/scripts/new-project" node upd1
    local p="$PROJECTS_DIR/upd1"
    echo "# template fix" >> "$sb/templates/_shared/compose.yaml"
    (cd "$p" && "$sb/scripts/dev.real" update) > "$WORK/upd1.out"
    grep -qx "# template fix" "$p/compose.yaml"
    grep -q "compose.yaml" "$WORK/upd1.out"
    grep -q "$(sha256sum "$p/compose.yaml" | cut -d' ' -f1) compose.yaml" "$p/.devcontainer/template.lock"
}

update_never_overwrites_edits() {
    local sb="$WORK/sb-edits"; make_sandbox "$sb"
    "$sb/scripts/new-project" node upd2
    local p="$PROJECTS_DIR/upd2"
    echo "mine:" >> "$p/justfile"
    cp "$p/justfile" "$WORK/upd2-justfile"
    echo "# template fix" >> "$sb/templates/node/scaffold/justfile"
    (cd "$p" && "$sb/scripts/dev.real" update) > "$WORK/upd2.out"
    cmp "$WORK/upd2-justfile" "$p/justfile"
    grep -qx "# template fix" "$p/justfile.template-new"
    grep -qi "conflict" "$WORK/upd2.out"
    grep -q "justfile" "$WORK/upd2.out"
}

update_skips_edited_file_when_template_unchanged() {
    local sb="$WORK/sb-same"; make_sandbox "$sb"
    "$sb/scripts/new-project" node upd3
    local p="$PROJECTS_DIR/upd3"
    echo "mine:" >> "$p/justfile"
    (cd "$p" && "$sb/scripts/dev.real" update) > "$WORK/upd3.out"
    [[ ! -e "$p/justfile.template-new" ]]
    grep -qi "up to date" "$WORK/upd3.out"
}

update_keeps_adopted_settings() {
    local sb="$WORK/sb-adopt"; make_sandbox "$sb"
    make_repo "$WORK/src/upd4" "Gemfile=x" ".ruby-version=3.3.6"
    "$sb/scripts/new-project" rails upd4 --from "$WORK/src/upd4"
    local p="$PROJECTS_DIR/upd4"
    sed -i 's|"shutdownAction": "none",|"shutdownAction": "none",\n  "updateContentCommand": "true",|' \
        "$sb/templates/rails/scaffold/.devcontainer/devcontainer.json"
    (cd "$p" && "$sb/scripts/dev.real" update) > /dev/null
    grep -q '"updateContentCommand"' "$p/.devcontainer/devcontainer.json"
    [[ "$(feature_version "$p" '"\.\/ruby"')" == "3.3.6" ]]
}

update_adds_new_files_and_respects_deletions() {
    local sb="$WORK/sb-files"; make_sandbox "$sb"
    "$sb/scripts/new-project" node upd5
    local p="$PROJECTS_DIR/upd5"
    rm "$p/.gitignore"
    echo "new" > "$sb/templates/node/scaffold/.editorconfig"
    echo "# template fix" >> "$sb/templates/node/scaffold/.gitignore"
    (cd "$p" && "$sb/scripts/dev.real" update) > /dev/null
    [[ -f "$p/.editorconfig" ]]
    [[ ! -e "$p/.gitignore" ]]
}

update_keeps_services_and_ide() {
    local sb="$WORK/sb-svc"; make_sandbox "$sb"
    PATH="$WORK/bin:$PATH" "$sb/scripts/new-project" node upd6 --with postgres --ide=vscode
    local p="$PROJECTS_DIR/upd6"
    echo "# template fix" >> "$sb/templates/_shared/compose.yaml"
    sed -i 's|"name": "{{PROJECT_NAME}}",|"name": "{{PROJECT_NAME}}",\n  "updateContentCommand": "true",|' \
        "$sb/templates/node/scaffold/.devcontainer/devcontainer.json"
    (cd "$p" && "$sb/scripts/dev.real" update) > /dev/null
    grep -qx '  - compose.postgres.yaml' "$p/compose.yaml"
    grep -qx "# template fix" "$p/compose.yaml"
    grep -q '"updateContentCommand"' "$p/.devcontainer/devcontainer.json"
    grep -q '"biomejs.biome"' "$p/.devcontainer/devcontainer.json"
    jsonc_valid "$p/.devcontainer/devcontainer.json"
}

update_without_lock_explains() {
    "$NEW_PROJECT" node upd7
    local p="$PROJECTS_DIR/upd7"
    rm "$p/.devcontainer/template.lock"
    cp "$p/compose.yaml" "$WORK/upd7-compose"
    fails bash -c "cd '$p' && '$SANDBOX/scripts/dev.real' update" > "$WORK/upd7.out" 2>&1
    grep -q "template.lock" "$WORK/upd7.out"
    cmp "$WORK/upd7-compose" "$p/compose.yaml"
}

update_leaves_untracked_file_that_differs() {
    local sb="$WORK/sb-differs"; make_sandbox "$sb"
    make_repo "$WORK/src/upd9" ".gitignore=mine" "package.json={}"
    "$sb/scripts/new-project" node upd9 --from "$WORK/src/upd9"
    local p="$PROJECTS_DIR/upd9"
    echo "# template fix" >> "$sb/templates/node/scaffold/.gitignore"
    (cd "$p" && "$sb/scripts/dev.real" update) > /dev/null
    [[ "$(cat "$p/.gitignore")" == mine ]]
    [[ ! -e "$p/.gitignore.template-new" ]]
    fails grep -q " .gitignore$" "$p/.devcontainer/template.lock"
}

usage_rejects_incomplete_from() {
    fails "$NEW_PROJECT" rails x --from > /dev/null 2>&1
    fails "$NEW_PROJECT" rails x --bogus y > /dev/null 2>&1
    [[ ! -e "$PROJECTS_DIR/x" ]]
}

