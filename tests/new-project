update_brings_template_env_change() {
    local sb="$WORK/sb-tenv2"; make_sandbox "$sb"
    printf 'FEATURE_FLAG=on\n' > "$sb/templates/node/env"
    "$sb/scripts/new-project" node tenv2
    printf 'OTHER=1\n' >> "$sb/templates/node/env"
