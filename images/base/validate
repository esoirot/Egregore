#!/usr/bin/env bash
# Image checks run by scripts/install and CI after the image is available.
# Usage: validate <image>
set -euo pipefail

IMAGE="$1"

USER_NAME="$(docker run --rm "$IMAGE" whoami)"
[[ "$USER_NAME" == "dev" ]] || { echo "$IMAGE runs as $USER_NAME, expected dev"; exit 1; }

echo "✓ User: $USER_NAME"
echo "✓ just: $(docker run --rm "$IMAGE" just --version)"
