{
  "id": "uv",
  "version": "1.0.0",
  "name": "uv + Python",
  "description": "Installs an exact uv version and bakes an exact Python into the image.",
  "options": {
    "version": {
      "type": "string",
      // renovate: datasource=pypi depName=uv
      "default": "0.12.23",
      "description": "Exact uv version"
    },
    "python": {
      "type": "string",
      // renovate: datasource=python-version depName=python
      "default": "3.14.8",
      "description": "Exact Python version installed by uv"
    }
  },
  "containerEnv": {
    "UV_PYTHON_INSTALL_DIR": "/opt/uv-python",
    "UV_LINK_MODE": "copy"
  }
}
