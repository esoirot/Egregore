# shellcheck shell=bash
# Scenarios for the eonax template: the data space stack keeps the Kubernetes-ready rules
# (see templates/eonax/scaffold/README.md, "Kubernetes-ready rules").
# Sourced by tests/new-project, which provides the helpers and variables.

# eonax_stack_json <project>: the resolved compose configuration (JSON).
eonax_stack_json() {
    docker compose -f "$1/compose.yaml" config --format json
}

eonax_stack_is_kubernetes_ready() {
    "$NEW_PROJECT" eonax eonax-k8s
    local p="$PROJECTS_DIR/eonax-k8s"
    eonax_stack_json "$p" | python3 -c 'import json, os, sys
project = sys.argv[1]
services = {n: s for n, s in json.load(sys.stdin)["services"].items() if n != "dev"}
assert services, "no data space services"
for name, s in services.items():
    where = "service " + name + ": "
    job = s.get("labels", {}).get("eonax.role") == "job"
    if job:
        assert s.get("restart", "no") == "no", where + "a job runs once (restart: no), like a Kubernetes Job"
    else:
        assert "healthcheck" in s, where + "needs a healthcheck (readiness probe), or label eonax.role: job"
    assert "network_mode" not in s, where + "network_mode does not exist in Kubernetes"
    for v in s.get("volumes", []):
        assert v["type"] != "bind" or v["source"].startswith(project + "/"), where + "binds a host path: " + v["source"]
    if "build" in s:
        b = s["build"]
        assert os.path.isfile(os.path.join(b["context"], b.get("dockerfile", "Dockerfile"))), where + "build without a Dockerfile"
    else:
        assert "@sha256:" in s["image"], where + "image must be pinned by digest"
' "$p"
}

eonax_project_has_the_connector_sources() {
    "$NEW_PROJECT" eonax eonax-src
    local p="$PROJECTS_DIR/eonax-src"
    local f
    for f in connector/settings.gradle.kts connector/gradle/libs.versions.toml \
             connector/controlplane/build.gradle.kts connector/dataplane/build.gradle.kts connector/Dockerfile; do
        [[ -f "$p/$f" ]] || { echo "missing $f"; return 1; }
    done
    grep -qE '^edc = "[0-9]+\.[0-9]+\.[0-9]+"$' "$p/connector/gradle/libs.versions.toml"
}

eonax_gaiax_mock_stays_isolated() {
    "$NEW_PROJECT" eonax eonax-mock
    local p="$PROJECTS_DIR/eonax-mock" refs
    # The mock lives in gaiax-mock/; only the switch points may name it.
    refs="$(cd "$p" && grep -rl "gaiax-mock" --exclude-dir=gaiax-mock --exclude-dir=.git --exclude=template.lock . | sort | tr '\n' ' ')"
    [[ "$refs" == "./.env ./.env.example ./README.md ./compose.template.yaml ./dataspace/check-gaiax ./dataspace/gaiax " ]] \
        || { echo "mock referenced outside its switch points: $refs"; return 1; }
    ! grep -rqi "mock" "$p/connector/gaiax"
}

# The course material (connector, dataspace scripts, app, README) follows template fixes.
eonax_update_reaches_the_course_material() {
    local sb="$WORK/sb-eonax"; make_sandbox "$sb"
    "$sb/scripts/new-project" eonax eonax-upd
    local p="$PROJECTS_DIR/eonax-upd"
    echo '{"edited": true}' > "$p/dataspace/requests/asset.json"
    local f
    for f in dataspace/transfer connector/Dockerfile app/index.html README.md dataspace/requests/asset.json; do
        echo "# template fix" >> "$sb/templates/eonax/scaffold/$f"
    done
    (cd "$p" && "$sb/scripts/dev.real" update) > "$WORK/eonax-upd.out"
    for f in dataspace/transfer connector/Dockerfile app/index.html README.md; do
        grep -qx "# template fix" "$p/$f" || { echo "not updated: $f"; return 1; }
    done
    [[ -x "$p/dataspace/transfer" ]]
    grep -qx '{"edited": true}' "$p/dataspace/requests/asset.json"
    grep -qx "# template fix" "$p/dataspace/requests/asset.json.template-new"
}

# renovate: datasource=npm depName=playwright-core
PLAYWRIGHT_VERSION=1.63.0 # the image's browsers must match the package: one version for both

# The trip planner's map, drawn by a real browser from the template's sample data (app-layout.mjs).
eonax_map_labels_do_not_overlap() {
    "$NEW_PROJECT" eonax eonax-map
    local p="$PROJECTS_DIR/eonax-map" t="$SANDBOX/templates/eonax"
    docker run --rm -v "$p/app:/app:ro" -v "$p/gtfs-backend/gtfs:/gtfs:ro" \
        -v "$p/poi-backend/pois.geojson:/pois.geojson:ro" -v "$t/app-layout.mjs:/check/app-layout.mjs:ro" \
        "mcr.microsoft.com/playwright:v$PLAYWRIGHT_VERSION-noble" bash -c \
        "cd /tmp && npm install --silent --no-audit --no-fund playwright-core@$PLAYWRIGHT_VERSION > /dev/null \
         && cp /check/app-layout.mjs . && node app-layout.mjs"
}

# Waits that pass on a fast machine time out on a slow CI runner: every polling loop of the course
# scripts (for _ in $(seq 1 N) ... sleep S) gives at least a minute.
eonax_waits_allow_a_slow_machine() {
    local d="$SANDBOX/templates/eonax/scaffold/dataspace"
    find "$d" -maxdepth 1 -type f -exec awk '/for _ in \$\(seq 1 [0-9]+\)/ { match($0, /seq 1 [0-9]+/); n = substr($0, RSTART + 6, RLENGTH - 6); f = FILENAME; l = FNR }
         n && /sleep [0-9.]+/ { match($0, /sleep [0-9.]+/); s = substr($0, RSTART + 6, RLENGTH - 6); loops++
                               if (n * s < 60) { print f ":" l ": waits " n * s " s"; bad = 1 }; n = 0 }
         END { if (!loops) { print "no polling loop found"; bad = 1 }; exit bad }' {} +
}

scenario "eonax: the data space stack keeps the Kubernetes-ready rules" eonax_stack_is_kubernetes_ready
scenario "eonax: a new project gets the connector sources" eonax_project_has_the_connector_sources
scenario "eonax: the Gaia-X mock stays in gaiax-mock/ and its switch points" eonax_gaiax_mock_stays_isolated
scenario "eonax: dev update reaches the course material" eonax_update_reaches_the_course_material
scenario "eonax: the map labels do not overlap" eonax_map_labels_do_not_overlap
scenario "eonax: polling loops allow a slow machine" eonax_waits_allow_a_slow_machine
