# shellcheck shell=bash
# Scenarios for the eonax template: the data space stack keeps the Kubernetes-ready rules
# (see templates/eonax/scaffold/README.md, "Kubernetes-ready rules").
# Sourced by tests/new-project, which provides the helpers and variables.

# eonax_stack_json <project>: the resolved compose configuration (JSON).
eonax_stack_json() {
    docker compose -f "$1/compose.yaml" config --format json
}

# kubernetes_ready <project>: the resolved compose configuration on stdin keeps the rules.
kubernetes_ready() {
    python3 -c 'import json, os, sys
project = sys.argv[1]
services = {n: s for n, s in json.load(sys.stdin)["services"].items() if n != "dev"}
assert services, "no data space services"
for name, s in services.items():
    where = "service " + name + ": "
    job = s.get("labels", {}).get("eonax.role") == "job"
    if job:
        assert s.get("restart", "no") == "no", where + "a job runs once (restart: no), like a Kubernetes Job"
    else:
        assert "healthcheck" in s, where + "needs a healthcheck (readiness probe), or label eonax.role: job"
    assert "network_mode" not in s, where + "network_mode does not exist in Kubernetes"
    for v in s.get("volumes", []):
        assert v["type"] != "bind" or v["source"].startswith(project + "/"), where + "binds a host path: " + v["source"]
    if "build" in s:
        b = s["build"]
        assert os.path.isfile(os.path.join(b["context"], b.get("dockerfile", "Dockerfile"))), where + "build without a Dockerfile"
    elif s["image"] not in {v.get("image") for v in services.values() if "build" in v}:
        assert "@sha256:" in s["image"], where + "image must be pinned by digest (or built by another service here)"
' "$1"
}

eonax_stack_is_kubernetes_ready() {
    "$NEW_PROJECT" eonax eonax-k8s
    local p="$PROJECTS_DIR/eonax-k8s"
    eonax_stack_json "$p" | kubernetes_ready "$p"
}

eonax_project_has_the_connector_sources() {
    "$NEW_PROJECT" eonax eonax-src
    local p="$PROJECTS_DIR/eonax-src"
    local f
    for f in connector/settings.gradle.kts connector/gradle/libs.versions.toml \
             connector/controlplane/build.gradle.kts connector/dataplane/build.gradle.kts connector/Dockerfile; do
        [[ -f "$p/$f" ]] || { echo "missing $f"; return 1; }
    done
    grep -qE '^edc = "[0-9]+\.[0-9]+\.[0-9]+"$' "$p/connector/gradle/libs.versions.toml"
}

eonax_gaiax_mock_stays_isolated() {
    "$NEW_PROJECT" eonax eonax-mock
    local p="$PROJECTS_DIR/eonax-mock" refs
    # The mock lives in gaiax-mock/; only the switch points may name it.
    refs="$(cd "$p" && grep -rl "gaiax-mock" --exclude-dir=gaiax-mock --exclude-dir=.git --exclude=template.lock . | sort | tr '\n' ' ')"
    [[ "$refs" == "./.env ./.env.example ./README.md ./compose.template.yaml ./dataspace/check-gaiax ./dataspace/gaiax " ]] \
        || { echo "mock referenced outside its switch points: $refs"; return 1; }
    ! grep -rqi "mock" "$p/connector/gaiax"
}

# The course material (connector, dataspace scripts, app, README) follows template fixes.
eonax_update_reaches_the_course_material() {
    local sb="$WORK/sb-eonax"; make_sandbox "$sb"
    "$sb/scripts/new-project" eonax eonax-upd
    local p="$PROJECTS_DIR/eonax-upd"
    echo '{"edited": true}' > "$p/dataspace/requests/asset.json"
    local f
    for f in dataspace/transfer connector/Dockerfile app/index.html README.md dataspace/requests/asset.json; do
        echo "# template fix" >> "$sb/templates/eonax/scaffold/$f"
    done
    (cd "$p" && "$sb/scripts/dev.real" update) > "$WORK/eonax-upd.out"
    for f in dataspace/transfer connector/Dockerfile app/index.html README.md; do
        grep -qx "# template fix" "$p/$f" || { echo "not updated: $f"; return 1; }
    done
    [[ -x "$p/dataspace/transfer" ]]
    grep -qx '{"edited": true}' "$p/dataspace/requests/asset.json"
    grep -qx "# template fix" "$p/dataspace/requests/asset.json.template-new"
}

# renovate: datasource=npm depName=playwright-core
PLAYWRIGHT_VERSION=1.63.0 # the image's browsers must match the package: one version for both

# The trip planner's map, drawn by a real browser from the template's sample data (app-layout.mjs).
eonax_map_labels_do_not_overlap() {
    "$NEW_PROJECT" eonax eonax-map
    local p="$PROJECTS_DIR/eonax-map" t="$SANDBOX/templates/eonax"
    docker run --rm -v "$p/app:/app:ro" -v "$p/gtfs-backend/gtfs:/gtfs:ro" \
        -v "$p/poi-backend/pois.geojson:/pois.geojson:ro" -v "$t/app-layout.mjs:/check/app-layout.mjs:ro" \
        "mcr.microsoft.com/playwright:v$PLAYWRIGHT_VERSION-noble" bash -c \
        "cd /tmp && npm install --silent --no-audit --no-fund playwright-core@$PLAYWRIGHT_VERSION > /dev/null \
         && cp /check/app-layout.mjs . && node app-layout.mjs"
}

# Waits that pass on a fast machine time out on a slow CI runner: every polling loop of the course
# scripts (for _ in $(seq 1 N) ... sleep S) gives at least a minute.
eonax_waits_allow_a_slow_machine() {
    local d="$SANDBOX/templates/eonax/scaffold/dataspace"
    find "$d" -maxdepth 1 -type f -exec awk '/for _ in \$\(seq 1 [0-9]+\)/ { match($0, /seq 1 [0-9]+/); n = substr($0, RSTART + 6, RLENGTH - 6); f = FILENAME; l = FNR }
         n && /sleep [0-9.]+/ { match($0, /sleep [0-9.]+/); s = substr($0, RSTART + 6, RLENGTH - 6); loops++
                               if (n * s < 60) { print f ":" l ": waits " n * s " s"; bad = 1 }; n = 0 }
         END { if (!loops) { print "no polling loop found"; bad = 1 }; exit bad }' {} +
}

# Each connector module is built once; its twin runtime (provider/consumer) runs the same image.
eonax_runtimes_build_once() {
    "$NEW_PROJECT" eonax eonax-once
    local p="$PROJECTS_DIR/eonax-once"
    eonax_stack_json "$p" | python3 -c 'import json, sys
s = json.load(sys.stdin)["services"]
builds = {n: v for n, v in s.items() if v.get("build", {}).get("context", "").endswith("/connector")}
modules = sorted(v["build"]["args"]["MODULE"] for v in builds.values())
assert modules == ["controlplane", "dataplane", "identityhub", "issuerservice"], "one build per module, not: %s" % modules
built = {v["image"] for v in builds.values()}
assert all(i.startswith("eonax-once-") for i in built), "image names must carry the project name: %s" % built
runners = [n for n, v in s.items() if v.get("image") in built]
assert len(runners) == 7, "7 runtimes run the 4 images, not: %s" % runners
for n in runners:
    if n not in builds:
        assert s[n].get("pull_policy") == "never", n + " must never pull its locally built image"
'
}

# Management API v4 (EDC 0.18.1): v3 only where v4 does not exist yet (the EDR cache).
eonax_management_calls_use_v4() {
    local d="$SANDBOX/templates/eonax/scaffold" left
    left="$(grep -rnE '/v3/' "$d/dataspace" "$d/app" "$d/deploy" | grep -v '/v3/edrs' || true)"
    [[ -z "$left" ]] || { echo "v3 management calls left:"; echo "$left"; return 1; }
}

eonax_management_bodies_use_the_v4_context() {
    local f
    for f in "$SANDBOX"/templates/eonax/scaffold/dataspace/requests/{asset,policy,contract-,transfer-request,catalog}*.json; do
        python3 -c 'import json, sys
body = json.load(open(sys.argv[1]))
ctx = body.get("@context")
assert isinstance(ctx, list) and "https://w3id.org/edc/connector/management/v2" in ctx, "@context must list management/v2"
assert body.get("@type"), "@type missing"
' "$f" || { echo "in ${f##*/}"; return 1; }
    done
}

# --- deploy profile (deploy/): a hosted data space learners only look at --------------------------
DEPLOY_SECRETS=(PROVIDER_API_KEY CONSUMER_API_KEY IDENTITYHUB_SUPERUSER_KEY ISSUER_SUPERUSER_KEY EDC_DB_PASSWORD
    VAULT_TOKEN_ISSUERSERVICE VAULT_TOKEN_PROVIDER_IDENTITYHUB VAULT_TOKEN_PROVIDER_CONTROLPLANE
    VAULT_TOKEN_PROVIDER_DATAPLANE VAULT_TOKEN_CONSUMER_IDENTITYHUB VAULT_TOKEN_CONSUMER_CONTROLPLANE
    VAULT_TOKEN_CONSUMER_DATAPLANE)

eonax_deploy_init_generates_secrets() {
    "$NEW_PROJECT" eonax eonax-dinit
    local p="$PROJECTS_DIR/eonax-dinit" v value
    "$p/deploy/init" > /dev/null
    [[ "$(stat -c %a "$p/deploy/.env")" == 600 ]] || { echo "deploy/.env is not 0600"; return 1; }
    for v in "${DEPLOY_SECRETS[@]}"; do
        value="$(sed -n "s/^$v=//p" "$p/deploy/.env")"
        [[ ${#value} -ge 24 ]] || { echo "$v missing or short: '$value'"; return 1; }
        if grep -qF -- "$value" "$p/compose.template.yaml"; then echo "$v is a dev default"; return 1; fi
    done
    [[ "$(grep -E "^($(IFS='|'; echo "${DEPLOY_SECRETS[*]}"))=" "$p/deploy/.env" | cut -d= -f2- | sort -u | wc -l)" \
        -eq ${#DEPLOY_SECRETS[@]} ]] || { echo "secrets are not all different"; return 1; }
    cp "$p/deploy/.env" "$WORK/dinit.env"
    "$p/deploy/init" > /dev/null
    cmp "$WORK/dinit.env" "$p/deploy/.env"
}

eonax_deploy_up_refuses_weak_secrets() {
    "$NEW_PROJECT" eonax eonax-dweak
    local p="$PROJECTS_DIR/eonax-dweak"
    "$p/deploy/init" > /dev/null
    sed -i 's/^PROVIDER_API_KEY=.*/PROVIDER_API_KEY=provider-api-key/; s/^EDC_DB_PASSWORD=.*/EDC_DB_PASSWORD=/' "$p/deploy/.env"
    fails "$p/deploy/up" > "$WORK/dweak.out" 2>&1
    grep -q PROVIDER_API_KEY "$WORK/dweak.out" || { echo "default not named: $(cat "$WORK/dweak.out")"; return 1; }
    grep -q EDC_DB_PASSWORD "$WORK/dweak.out" || { echo "empty not named: $(cat "$WORK/dweak.out")"; return 1; }
    [[ -z "$(docker ps -aq --filter label=com.docker.compose.project=eonax-dweak-deploy)" ]]
}

eonax_deploy_stack_is_closed() {
    "$NEW_PROJECT" eonax eonax-dclosed
    local p="$PROJECTS_DIR/eonax-dclosed"
    "$p/deploy/init" > /dev/null
    "$p/deploy/up" --config > "$WORK/dclosed.json"
    kubernetes_ready "$p" < "$WORK/dclosed.json"
    python3 -c 'import json, sys
s = json.load(open(sys.argv[1]))["services"]
published = sorted(n for n, v in s.items() if v.get("ports"))
assert published == ["caddy"], "only caddy may publish ports, not: %s" % published
for n in ("dev", "gaiax-mock"):
    assert n not in s, n + " must not be deployed"
for n, v in s.items():
    for m in v.get("volumes", []):
        assert "docker.sock" not in m.get("source", ""), n + " mounts the Docker socket"
assert "IPC_LOCK" in s["vault"].get("cap_add", []), "vault needs IPC_LOCK (mlock)"
assert json.loads(s["vault"]["environment"]["VAULT_LOCAL_CONFIG"])["disable_mlock"] is False, "mlock must stay on"
tokens = [v["environment"]["EDC_VAULT_HASHICORP_TOKEN"] for v in s.values() if "EDC_VAULT_HASHICORP_TOKEN" in v.get("environment", {})]
assert len(tokens) == 7 and len(set(tokens)) == 7, "each runtime needs its own Vault token"
' "$WORK/dclosed.json"
}

