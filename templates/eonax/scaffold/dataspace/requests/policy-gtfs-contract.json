{
  "@context": { "@vocab": "https://w3id.org/edc/v0.0.1/ns/" },
  "@id": "gtfs-contract",
  "policy": {
    "@context": "http://www.w3.org/ns/odrl.jsonld",
    "@type": "Set",
    "permission": [
      {
        "action": "use",
        "constraint": [
          { "leftOperand": "MembershipCredential", "operator": "eq", "rightOperand": "active" },
          { "leftOperand": "purpose", "operator": "eq", "rightOperand": "mobility" },
          { "leftOperand": "inForceDate", "operator": "lteq", "rightOperand": "contractAgreement+1d" }
        ]
      }
    ]
  }
}
