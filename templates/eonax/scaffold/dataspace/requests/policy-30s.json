{
  "@context": ["https://w3id.org/edc/connector/management/v2"],
  "@type": "PolicyDefinition",
  "@id": "30s-contract",
  "policy": {
    "@type": "Set",
    "permission": [
      {
        "action": "use",
        "constraint": [
          { "leftOperand": "edc:MembershipCredential", "operator": "eq", "rightOperand": "active" },
          { "leftOperand": "edc:inForceDate", "operator": "lteq", "rightOperand": "contractAgreement+30s" }
        ]
      }
    ]
  }
}
