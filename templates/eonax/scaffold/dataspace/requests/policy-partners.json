{
  "@context": ["https://w3id.org/edc/connector/management/v2"],
  "@type": "PolicyDefinition",
  "@id": "partners-only",
  "policy": {
    "@type": "Set",
    "permission": [
      {
        "action": "use",
        "constraint": [
          { "leftOperand": "edc:PartnerCredential", "operator": "eq", "rightOperand": "active" }
        ]
      }
    ]
  }
}
