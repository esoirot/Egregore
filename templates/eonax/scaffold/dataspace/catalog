#!/usr/bin/env bash
# Consumer: ask the provider's connector what it offers (Dataspace Protocol catalog request).
# The consumer calls its OWN management API; its connector talks to the provider's connector.
# Each dataset comes with an offer (odrl:hasPolicy): the contract a consumer can ask for, rules included.
# Only offers whose access policy the consumer passes are listed.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

if ! management consumer POST /v4/catalog/request "$(cat "$REQUESTS/catalog-request.json")" > "$STATE/catalog.json"; then
    echo "Refused: $(cat "$STATE/catalog.json")" >&2
    echo "(the provider only answers members: does the consumer hold a MembershipCredential? just membership consumer)" >&2
    exit 1
fi

# One dataset is an object, several are an array: normalize to an array. Keep each offer whole
# (its rules included): negotiate sends it back as is.
datasets="$(jq -c '[.["dataset"] // .["dcat:dataset"]] | flatten | map(select(. != null))' "$STATE/catalog.json")"
if [[ "$(jq length <<< "$datasets")" -eq 0 ]]; then echo "No offers: run 'just publish' first." >&2; exit 1; fi
for asset in $(jq -r '.[]["@id"]' <<< "$datasets"); do
    jq --arg a "$asset" 'map(select(.["@id"] == $a))[0] | [.hasPolicy // .["odrl:hasPolicy"]] | flatten | .[0]' \
        <<< "$datasets" > "$STATE/offer.$asset.json"
    echo "dataset $asset: $(jq -r --arg a "$asset" 'map(select(.["@id"] == $a))[0] | .name // .["edc:name"] // ""' <<< "$datasets")"
    echo "  rules: $(jq -c '.permission // .["odrl:permission"]' "$STATE/offer.$asset.json")"
done
echo "Full answer: $STATE/catalog.json. Next: just negotiate [asset] (default $ASSET_ID)"
