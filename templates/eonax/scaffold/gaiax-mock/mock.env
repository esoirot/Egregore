# shellcheck shell=bash disable=SC2034
# MOCK settings: what dataspace/gaiax uses when no GAIAX_* variable is set. The real ones go in .env
# (see the env file of this template); then these are never read and the mock does not start.
GAIAX_DID="did:web:gaiax-mock%3A8080:provider"
GAIAX_DID_WEB_USE_HTTP=true # the mock serves plain HTTP; real did:web is HTTPS
GAIAX_CERT_CHAIN_URL="http://gaiax-mock:8080/x509CertificateChain.pem"
GAIAX_COMPLIANCE_URL="http://gaiax-mock:8080/compliance/v2"
GAIAX_NOTARY_URL="http://gaiax-mock:8080/notary/v2"
GAIAX_LEGAL_NAME="Demo Transit SAS (synthetic)"
GAIAX_REGISTRATION_NUMBER="lei-code:969500M0CKSYNTHET100"
GAIAX_COUNTRY_CODE="FR"
