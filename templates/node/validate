#!/usr/bin/env bash
# Template-specific checks run by scripts/install after the image is built.
# Usage: validate <image>
set -euo pipefail

IMAGE="$1"

NODE_VERSION="$(docker run --rm "$IMAGE" node --version)"
PNPM_VERSION="$(docker run --rm "$IMAGE" pnpm --version)"
NVM_VERSION="$(docker run --rm "$IMAGE" bash -lc 'source "$NVM_DIR/nvm.sh" && nvm --version')"

echo "✓ Node: $NODE_VERSION"
echo "✓ pnpm: $PNPM_VERSION"
echo "✓ nvm: $NVM_VERSION"
